<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--
      Suppressions are deliberate and individually justified. Anything not listed here is an error,
      including the whole CA5xxx security category and the correctness rules (CA1001/CA2000/CA2213
      disposal, CA1031 catch-all, IDE0005 unused usings, IDE0051/IDE0052 unused members).
    -->
    <NoWarn>$(NoWarn);
      CS1591;CS1573;               <!-- XML docs: the public surface is documented where it matters, not on every member. -->
      CA1062;                      <!-- Null-check public arguments: entry points use ArgumentNullException.ThrowIfNull; internals rely on nullable reference types. -->
      CA1303;CA1305;CA1307;CA1310; <!-- Localisation and culture: UkFormat pins every client-facing string to en-GB; everything else is invariant by intent. -->
      CA2007;                      <!-- ConfigureAwait: this is an application, not a library, and there is no synchronisation context to capture. -->
      CA1848;                      <!-- LoggerMessage source generators: not worth the ceremony at this log volume. -->
      CA1716;CA1724;               <!-- Names that clash with language keywords or namespaces: the domain vocabulary wins. -->
      CA1034;CA1819;               <!-- Nested types and array-returning properties: both are deliberate in the domain records. -->
      IDE0055;                     <!-- Formatting: dotnet format is not run in CI, so this would fail builds on whitespace. -->
      IDE0058;IDE0060;             <!-- Unused expression values and parameters: both fire heavily on interface implementations. -->
      IDE0010;IDE0072              <!-- Exhaustive switch: the compiler already checks what matters. -->
    </NoWarn>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Authors>Callan Jackson</Authors>
    <Product>SwitchPoint</Product>
    <Copyright>Copyright © 2026 Callan Jackson</Copyright>
    <RepositoryUrl>https://github.com/callan-jackson/switchpoint</RepositoryUrl>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1707;CA2007;CA1861;xUnit1004;CA1515;CA1852</NoWarn>
  </PropertyGroup>
</Project>
