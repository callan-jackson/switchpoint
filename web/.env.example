# Reference for every variable the web app reads. All variables must be prefixed VITE_ to reach the browser.
#
# For LOCAL DEVELOPMENT you do not need to copy this file: .env.development is committed with working
# defaults. To override one locally, create .env.development.local — Vite ranks it above .env.development,
# whereas .env.local is ranked BELOW it and will appear to do nothing in dev mode.
#
# For a DEPLOYED build, supply these as build-time environment variables.

# Serve sample data from an in-browser MSW worker instead of calling the API (true|false).
VITE_USE_MOCKS=false

# Label shown in the top-bar environment badge (e.g. Development, UAT, Production).
VITE_ENV_LABEL=Production

# Where `vite dev` proxies /api requests when mocks are off. Read by vite.config.ts, not by the app.
# Override per-shell when the API is on another port: VITE_API_PROXY=http://localhost:5093 npm run dev
VITE_API_PROXY=http://localhost:5080
