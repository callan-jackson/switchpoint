# Copy to .env.local and adjust. All variables must be prefixed VITE_ to reach the browser.

# Serve realistic sample data from an in-browser MSW worker instead of the API (true|false).
VITE_USE_MOCKS=false

# Label shown in the top-bar environment badge (e.g. Development, UAT, Production).
VITE_ENV_LABEL=Production

# Where `vite dev` proxies /api requests when mocks are off (read by vite.config.ts, not the app).
VITE_API_PROXY=http://localhost:5080
