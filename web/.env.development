# Local development defaults (committed, and overridable in .env.development.local, which is git-ignored).
#
# Mocks are OFF so that `dotnet run --project src/SwitchPoint.Api` plus `npm run dev` shows the real API,
# which is what the README describes. To demo or develop the UI with no API running, either set
# VITE_USE_MOCKS=true in .env.development.local or run `npm run dev:mocks`.
VITE_USE_MOCKS=false
VITE_ENV_LABEL=Development
