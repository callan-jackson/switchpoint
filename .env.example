# docker-compose environment. Copy to .env (git-ignored) and change both values.
#
#   cp .env.example .env
#   docker compose up --build

# SQL Server SA password. The container refuses to start unless it is at least 8 characters with
# three of: upper case, lower case, digit, symbol.
MSSQL_SA_PASSWORD=Change_Me_Str0ng!

# HMAC key the API signs JWT bearer tokens with (at least 32 characters).
# Generate one:  openssl rand -base64 48
JWT_SIGNING_KEY=replace-with-a-random-string-of-at-least-32-characters
